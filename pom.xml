<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.jeff_media</groupId>
    <name>AngelChest</name>
    <artifactId>AngelChest</artifactId>
    <version>14.0.0-RC5</version>
    <description>Best available death chest / grave plugin!</description>

    <properties>
        <spigot.website>https://www.spigotmc.org/resources/angelchestplus.88214/</spigot.website>
        <spigot.prefix>${project.name}</spigot.prefix>
        <spigot.main>${project.groupId}.angelchest.AngelChestMain</spigot.main>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>25</java.version>
        <maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
        <config.version>${maven.build.timestamp}</config.version>
        <!-- The premium profile is active by default; the both profile also builds free. -->
        <build.variant>premium</build.variant>
        <build.skip-both>false</build.skip-both>
    </properties>

    <build>
        <finalName>${project.name}-${project.version}-${build.variant}</finalName>
        <!--
            Compile a profile-specific copy of the Java sources. This lets the
            free build adjust the two premium gates without modifying sources
            in the working tree.
        -->
        <sourceDirectory>${project.build.directory}/generated-sources/${build.variant}</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-variant-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/generated-sources/${build.variant}</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/main/java</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-parameters</arg> <!-- for ACF -->
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.jeff_media.standalonepluginscreen.StandalonePluginScreen</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <configuration>
                    <relocations>
                        <relocation>
                            <pattern>com.jeff_media.jefflib</pattern>
                            <shadedPattern>de.jeff_media.angelchest.jefflib</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.jeff_media.customblockdata</pattern>
                            <shadedPattern>de.jeff_media.angelchest.customblockdata</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>de.jeff_media.customblocks</pattern>
                            <shadedPattern>de.jeff_media.angelchest.customblocks</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>co.aikar.commands</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.co.aikar.commands</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>co.aikar.locales</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.co.aikar.locales</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>de.jeff_media.updatechecker</pattern>
                            <shadedPattern>de.jeff_media.angelchest.updatechecker</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>co.aikar.commands</pattern>
                            <shadedPattern>de.jeff_media.angelchest.acf.commands</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>co.aikar.locales</pattern>
                            <shadedPattern>de.jeff_media.angelchest.acf.locales</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.jeff_media.cesspool</pattern>
                            <shadedPattern>de.jeff_media.angelchest.cesspool</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.google.gson</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.com.google.gson</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.apache.commons.lang3</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.org.apache.commons.lang3</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.apache.commons.io</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.org.apache.commons.io</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.intellij.lang.annotations</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.org.intellij.lang.annotations</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.jetbrains.annotations</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.org.jetbrains.annotations</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.javatuples</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.org.javatuples</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.zeroturnaround.zip</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.org.zeroturnaround.zip</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.bstats.bukkit</pattern>
                            <shadedPattern>de.jeff_media.angelchest.bstats</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>io.papermc.lib</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.io.papermc.lib</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.tcoded.folialib</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.com.tcoded.folialib</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>io.th0rgal.protectionlib</pattern>
                            <shadedPattern>de.jeff_media.angelchest.thirdparty.io.th0rgal.protectionlib</shadedPattern>
                        </relocation>
                    </relocations>
                    <artifactSet>
                        <excludes>
                            <exclude>org.slf4j</exclude>
                        </excludes>
                    </artifactSet>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>1.2.1</version>
                <executions>
                    <execution>
                        <phase>deploy</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <executable>java</executable>
                    <workingDirectory>${basedir}/../</workingDirectory>
                    <arguments>
                        <argument>-jar</argument>
                        <argument>${basedir}/../PluginCompiler.jar</argument>
                        <argument>AngelChest</argument>
                        <argument>${project.version}</argument>
                    </arguments>
                </configuration>
            </plugin>

        </plugins>

    </build>

    <profiles>
        <profile>
            <id>both</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>1.2.1</version>
                        <executions>
                            <execution>
                                <id>build-free-variant</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${build.skip-both}</skip>
                                    <executable>mvn</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>package</argument>
                                        <argument>-Pfree</argument>
                                        <argument>-Dbuild.skip-both=true</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>premium</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <build.variant>premium</build.variant>
            </properties>
        </profile>

        <profile>
            <id>free</id>
            <properties>
                <build.variant>free</build.variant>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>disable-premium-features</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <replace
                                                file="${project.build.directory}/generated-sources/${build.variant}/de/jeff_media/angelchest/AngelChestMain.java"
                                                token="return true;"
                                                value="return false;"/>
                                        <replace
                                                file="${project.build.directory}/generated-sources/${build.variant}/de/jeff_media/daddy/Daddy_Stepsister.java"
                                                token="premium = true;"
                                                value="premium = false;"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

